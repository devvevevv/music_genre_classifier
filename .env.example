# API / service settings (src/settings.py)
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.m4a

# Set to use Redis for the prediction cache; leave empty for the in-process LRU.
REDIS_URL=
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=86400

# Model / dataset locations (src/config.py)
# MODEL_PATH=models/model.pkl
# DATASET_DIR=dataset/genres_original
